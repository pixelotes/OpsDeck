# Flask Configuration
# --------------------
# A long, random string used for signing sessions and other security purposes.
# Generate a good one with: python -c 'import secrets; print(secrets.token_hex(24))'
SECRET_KEY='your-very-strong-and-random-secret-key-goes-here'


# Tells Flask how to find and load the application.
FLASK_APP=run:app

# Enables debug mode (1 for dev, 0 for prod)
FLASK_DEBUG=0

# Demo data (True for dev, False for prod)
SEED_DEMO_DATA=True

# Maximum size of any single request body, in megabytes. Caps file uploads and
# imports; a request over the limit is rejected with a 413 before anything is
# written to disk. Minimum 1, default 5.
MAX_UPLOAD_MB=5

# File extensions accepted by every upload in the app, comma separated. Leave it
# commented out to use the built-in list, which covers photos, scans, office and
# OpenDocument files, CSV/JSON/XML, archives, saved email and certificates.
# Note that svg, html and executables are excluded on purpose: they can carry
# script, and adding them here re-opens that door.
# UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,docx,csv,zip

# Timezone configuration
# ----------------------
# Application timezone using pytz format.
# Examples: 'Europe/Madrid', 'America/New_York', 'Asia/Tokyo', 'UTC'
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Default: Europe/Madrid
TIMEZONE='Europe/Madrid'


# Database Configuration
# ----------------------
# Required. PostgreSQL connection URI.
# Example: DATABASE_URL='postgresql://user:password@localhost:5432/opsdeck'
DATABASE_URL=


# SMTP Email Notification Settings (Optional)
# ---------------------------------------------
# Fill these out to enable email notifications.
# For Gmail, you will need to generate an "App Password".
SMTP_SERVER='smtp.gmail.com'
SMTP_PORT=587
EMAIL_USERNAME='your-email@gmail.com'
EMAIL_PASSWORD='your-gmail-app-password'
EMAIL_SENDER_NAME='Opsdeck Security Newsletter'


# Webhook Notification Settings (Optional)
# ----------------------------------------
# The URL to send a POST request to for webhook notifications.
# Can be a Slack Incoming Webhook, Discord Webhook, etc.
WEBHOOK_URL=


# Slack Bot Integration (Optional)
# ---------------------------------
# Bot User OAuth Token for sending Slack notifications.
# Must start with 'xoxb-'. Get it from your Slack App settings:
# https://api.slack.com/apps > Your App > OAuth & Permissions
# Required scopes: chat:write, users:read, users:read.email
SLACK_BOT_TOKEN=


# Google OAuth Settings (Optional)
# ---------------------------------
# Credentials from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret
# Microsoft Entra ID OAuth Settings (Optional)
# ---------------------------------------------
# Adds a "Sign in with Microsoft" button. Enabled only when both the client id and the
# tenant id are set. Single-tenant only: "common", "organizations" and "consumers" are
# rejected, so only accounts from your own tenant can sign in.
#
# App registration (Entra admin center > App registrations > New registration):
#   - Supported account types: "Accounts in this organizational directory only"
#   - Redirect URI (Web): https://<your-host>/login/azure/authorized
#       (http://localhost:5000/login/azure/authorized for local dev). Behind a reverse
#       proxy set TRUST_PROXY=1 so the redirect URI uses the public host and https.
#   - Certificates & secrets: create a client secret -> AZURE_OAUTH_CLIENT_SECRET
#   - API permissions: Microsoft Graph, delegated: openid, email, profile, User.Read
#       (grant admin consent so users are not prompted)
#   - Overview: "Application (client) ID" -> AZURE_OAUTH_CLIENT_ID,
#       "Directory (tenant) ID" -> AZURE_OAUTH_TENANT_ID
#
# Users are matched to existing OpsDeck users by their userPrincipalName (never by the
# admin-editable "mail" attribute); there is no auto-provisioning. On first sign-in the
# Entra object id is stored and used for every later sign-in.
#
# User sync (Administration > Entra ID Sync, or `flask entra-sync [--dry-run]`) reuses
# this same app registration and secret. It reads users with the client-credentials
# flow, so it additionally needs these Microsoft Graph *application* permissions, with
# admin consent: User.Read.All, GroupMember.Read.All. The sync is disabled by default;
# groups, default role and schedule are configured on that screen (the secret is only
# ever read from this environment variable, never stored in the database).
AZURE_OAUTH_CLIENT_ID=
AZURE_OAUTH_CLIENT_SECRET=
AZURE_OAUTH_TENANT_ID=

# Allows the OAuth flow to run over plain HTTP. Set to 1 for local development only.
#
# It does more than it says: the app also reads it as a signal that this is a
# development deployment, which turns off Talisman's HTTPS enforcement. Leaving it at 1
# in production would therefore stop redirecting HTTP to HTTPS, so it ships disabled
# and dev environments opt in.
OAUTHLIB_INSECURE_TRANSPORT=0


# MFA Configuration (Optional)
# -----------------------------
# Enable/disable IP-based MFA. When enabled, users logging from unknown IPs
# will receive an OTP code via email.
MFA_ENABLED=True


# Enterprise Plugin Configuration (Optional)
# -------------------------------------------
# Enable the enterprise plugin features (connectors, AI agent, etc.)
# Set to True to enable enterprise features. Requires the opsdeck-enterprise folder.
# Default: False (for open-core compatibility)
ENTERPRISE_ENABLED=False


# Admin User Initialization (Optional)
# -------------------------------------
# Credentials for the initial admin user created on first deployment.
# These are only used if no users exist in the database.
# Change these values in production for security.
DEFAULT_ADMIN_EMAIL='admin@example.com'
DEFAULT_ADMIN_INITIAL_PASSWORD='admin123'

# --- Encryption of secrets stored in the database (API connector credentials) ---
# Fernet key(s), comma-separated; the first encrypts, all decrypt. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a key derived from SECRET_KEY is used (rotating SECRET_KEY would then make the
# stored credentials unreadable). After setting or rotating it: flask rotate-data-encryption-key
DATA_ENCRYPTION_KEY=

# --- Atlassian connector ---
# The Atlassian connector only sends its API token to https://*.atlassian.net. List any other
# hosts it may use (comma-separated hostnames, https only), e.g. a custom domain for your site.
ATLASSIAN_ALLOWED_HOSTS=
